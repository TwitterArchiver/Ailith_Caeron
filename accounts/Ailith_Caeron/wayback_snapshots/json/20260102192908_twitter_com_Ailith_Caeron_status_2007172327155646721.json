      {
        "article": {},
        "attachments": {},
        "author_id": "1854674128193875968",
        "conversation_id": "2006594231750508918",
        "created_at": "2026-01-01T05:13:23.000Z",
        "edit_controls": {
          "editable_until": "2026-01-01T06:13:23.000Z",
          "edits_remaining": 5,
          "is_edit_eligible": false
        },
        "edit_history_tweet_ids": [
