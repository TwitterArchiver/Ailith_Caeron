            "urls": [
              {
                "display_url": "kuow.org/stories/chatgp…",
                "end": 491,
                "expanded_url": "https://www.kuow.org/stories/chatgpt-promised-to-help-her-find-her-soulmate-then-it-betrayed-her",
                "start": 468,
